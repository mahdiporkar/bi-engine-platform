{
  "realm": "bi-engine",
  "enabled": true,
  "displayName": "BI Engine",
  "clients": [
    {
      "clientId": "super-app",
      "name": "Super App",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "local-dev-secret",
      "redirectUris": [
        "http://localhost:8080/*",
        "http://localhost:5173/*",
        "http://localhost:8090/*"
      ],
      "webOrigins": [
        "http://localhost:8080",
        "http://localhost:5173",
        "http://localhost:8090"
      ],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true
    },
    {
      "clientId": "superset-operation",
      "name": "Superset Operation",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "local-dev-operation-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "attributes": {
        "access.token.lifespan": "300"
      }
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@example.local",
      "firstName": "BI",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-bi-engine"
      ]
    }
  ]
}
